#!/usr/bin/env bash
set -euo pipefail

# bbrew (and brew itself) can prompt for admin credentials mid-run when it
# needs to fix permissions or run privileged steps. Authenticate up front so
# the user isn't interrupted by a sudo prompt in the middle of the TUI.
if ! sudo -v; then
  echo "Administrator authentication is required to run bbrew." >&2
  exit 1
fi

# Keep the sudo timestamp alive for as long as bbrew is running.
while true; do
  sudo -n true
  sleep 60
  kill -0 "$$" 2>/dev/null || exit
done 2>/dev/null &
SUDO_KEEPALIVE_PID=$!
trap 'kill "$SUDO_KEEPALIVE_PID" 2>/dev/null' EXIT

if [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

exec bbrew "${@}"
