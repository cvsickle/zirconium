#!/usr/bin/env bash

BREW_PREFIX=/home/linuxbrew/.linuxbrew

if [[ ! -x "$BREW_PREFIX/bin/brew" ]]; then
    printf 'Homebrew is not installed at %s\n' "$BREW_PREFIX"
    read -r -p 'Press Enter to close...'
    exit 1
fi

eval "$("$BREW_PREFIX/bin/brew" shellenv)"

"$BREW_PREFIX/bin/bbrew" "$@"
status=$?

if (( status != 0 )); then
    printf '\nbbrew exited with status %d\n' "$status"
    read -r -p 'Press Enter to close...'
fi

exit "$status"