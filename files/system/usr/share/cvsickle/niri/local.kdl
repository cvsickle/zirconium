spawn-sh-at-startup "oniri --tiling-layout"

hotkey-overlay {
    skip-at-startup
}

input {
    focus-follows-mouse
}

environment {
  DMS_ENABLE_GTK_REFRESH "1"
  QT_QPA_PLATFORMTHEME "qt6ct"
  QT_QPA_PLATFORMTHEME_QT6 "qt6ct"
}

window-rule {
    match app-id="helium"
    default-column-width { proportion 1.0; }
}
window-rule {
    match app-id="com.microsoft.VSCode"
    default-column-width { proportion 1.0; }
}
window-rule {
    match app-id="app.freelens.Freelens"
    default-column-width { proportion 1.0; }
}
