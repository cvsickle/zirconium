{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)install-tools\\.sh$/",
        "/(^|/)install-oniri\\.sh$/",
        "/(^|/)install-gcm\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\w+_VERSION=\"(?<currentValue>.+?)\""
      ]
    }
  ]
}