{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)install-tools\\.sh$/",
        "/(^|/)install-oniri\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\w+_VERSION=\"(?<currentValue>.+?)\""
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)install-gcm\\.sh$/"
      ],
      "matchStrings": [
        "GCM_TAG=\"(?<currentValue>v[^\"]+)\"[\\s\\S]*?x86_64\\)[\\s\\S]*?GCM_SHA256=\"(?<currentDigest>[a-f0-9]{64})\"",
        "GCM_TAG=\"(?<currentValue>v[^\"]+)\"[\\s\\S]*?aarch64\\|arm64\\)[\\s\\S]*?GCM_SHA256=\"(?<currentDigest>[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "github-release-attachments",
      "depNameTemplate": "git-ecosystem/git-credential-manager"
    }
  ]
}